# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_BASE_PATH=/api/v1

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/ai_mystery_room

# AI (server only; not required until mystery generation is implemented)
GEMINI_API_KEY=
GEMINI_MODEL=

# Generation
MYSTERY_GENERATION_TIMEOUT_MS=90000
MYSTERY_GENERATION_MAX_RETRIES=2
MYSTERY_GENERATION_MAX_CONCURRENCY=2

# Security
SESSION_SECRET=
SESSION_TTL_HOURS=24
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Optional image generation
IMAGE_GENERATION_PROVIDER=local
IMAGE_GENERATION_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api/v1
